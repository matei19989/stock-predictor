{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=db;Database=stockpredictor;Username=admin;Password=CONFIGURE_IN_ENV"
  },
  "Jwt": {
    "Key": "CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "StockPredictor",
    "Audience": "StockPredictor",
    "ExpiryDays": "7"
  },
  "MlService": {
    "BaseUrl": "http://ml:8000"
  },
  "Hangfire": {
    "RefreshCron": "0 * * * *"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://frontend:3000" ]
  },
  "Turnstile": {
    "SecretKey": "CHANGE_ME",
    "SiteVerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
  }
}

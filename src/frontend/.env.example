# Copy this file to .env for local `npm run dev`.
# Not needed when running via docker compose — the root .env feeds build args.

# Backend API base URL. Leave empty to use Vite's dev proxy to http://localhost:5000.
VITE_API_URL=

# Cloudflare Turnstile public site key (baked into the bundle at build time).
VITE_TURNSTILE_SITE_KEY=

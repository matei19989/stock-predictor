# Copy this file to .env and fill in the values before running docker compose.
# .env is gitignored; never commit real secrets.

# Required — 32+ character random string used to sign JWTs.
# Generate with: openssl rand -base64 48
JWT_KEY=

# Cloudflare Turnstile — bot protection on auth endpoints.
# Get keys at https://dash.cloudflare.com → Turnstile.
# Site key is public (baked into the frontend bundle); secret key is server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional — enables GDELT BigQuery sentiment in the ML service.
# Without these, predictions still work but the 3 sentiment features degrade to NaN.
GCP_PROJECT_ID=
# Base64-encoded service account JSON (used by the deployed ml container).
# For local docker compose, leave empty; the ml service will mount
# ${APPDATA}/gcloud/application_default_credentials.json from the host instead.
GCP_CREDENTIALS_JSON=
